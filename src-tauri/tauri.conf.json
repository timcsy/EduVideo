{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EduVideo Studio",
  "version": "0.1.0",
  "identifier": "tw.eduvideo.studio",
  "build": {
    "devUrl": "http://127.0.0.1:4173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "EduVideo Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage", "deb"]
  }
}
